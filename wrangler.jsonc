{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mirachan-homepage",
	"main": "worker/index.js",
	"compatibility_date": "2026-07-26",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/shift/calendar.ics",
      "/shift/edit/*"
    ]
  },
  "vars": {
    "ADMIN_ENABLED": "true"
  },
  "triggers": {
    "crons": [
      "0 3 3 * *"
    ]
  },
  "routes": [
    {
      "pattern": "mirachan.net",
      "custom_domain": true
    }
  ],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mira-schedule",
			"database_id": "f910082a-a69b-45c5-b5a4-cbf5cef2b861",
			"migrations_dir": "migrations"
		}
	]
}
